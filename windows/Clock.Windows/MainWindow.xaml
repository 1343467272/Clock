<Window x:Class="Clock.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Clock.Windows.Localization"
        Title="{x:Static l:Text.AppTitle}" Height="720" Width="900"
        WindowStartupLocation="CenterScreen" Icon="Assets/icon.ico">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="TabTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,16"/>
        </Style>
        <DataTemplate x:Key="AlarmCard">
            <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" Background="#0D000000">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TimeText}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DaysText}" Margin="12,10,0,0" Foreground="#88000000"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LabelText}" Margin="2,4,0,0" Foreground="#AA000000"/>
                        <TextBlock Text="{Binding NextFireText}" Margin="2,4,0,0" Foreground="#77000000" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{x:Static l:Text.Edit}" Tag="{Binding Uuid}" Click="OnEditAlarm"/>
                        <Button Content="{x:Static l:Text.Delete}" Tag="{Binding Uuid}" Click="OnDeleteAlarm"/>
                        <ToggleButton Content="{Binding EnabledText}" Tag="{Binding Uuid}" IsChecked="{Binding Enabled}" Click="OnToggleAlarm"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TimerCard">
            <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" Background="#0D000000">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding RemainingDisplay}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="{Binding LabelText}" Margin="2,2,0,0" Foreground="#88000000"/>
                        <TextBlock Text="{Binding MetaText}" Margin="2,2,0,0" Foreground="#77000000" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{x:Static l:Text.StartPause}" Tag="{Binding Uuid}" Click="OnTimerStartPause"/>
                        <Button Content="{x:Static l:Text.AddOneMinute}" Tag="{Binding Uuid}" Click="OnTimerAdd"/>
                        <Button Content="{x:Static l:Text.Reset}" Tag="{Binding Uuid}" Click="OnTimerReset"/>
                        <Button Content="{x:Static l:Text.Delete}" Tag="{Binding Uuid}" Click="OnTimerDelete"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CityCard">
            <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" Background="#0D000000">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding LocalTime}" FontSize="18" Margin="12,0"/>
                    <Button Grid.Column="2" Content="{x:Static l:Text.Remove}" Tag="{Binding Id}" Click="OnRemoveCity"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1">
            <!-- ALARMS -->
            <TabItem Header="{x:Static l:Text.TabAlarms}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="{x:Static l:Text.AlarmsTitle}" Style="{StaticResource TabTitle}"/>
                        <Button Content="{x:Static l:Text.AddAlarm}" Click="OnAddAlarm" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AlarmList" ItemTemplate="{StaticResource AlarmCard}"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TIMER -->
            <TabItem Header="{x:Static l:Text.TabTimer}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="{x:Static l:Text.TimerTitle}" Style="{StaticResource TabTitle}"/>
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" Background="#0D000000">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TimerMinutesBox" Width="60" Text="0" ToolTip="{x:Static l:Text.Minutes}"/>
                            <TextBlock Text=":" VerticalAlignment="Center" FontSize="20"/>
                            <TextBox x:Name="TimerSecondsBox" Width="60" Text="0" ToolTip="{x:Static l:Text.Seconds}"/>
                            <TextBox x:Name="TimerLabelBox" Width="180" Margin="12,0,0,0" ToolTip="{x:Static l:Text.LabelOptional}"/>
                            <Button Content="{x:Static l:Text.StartTimer}" Click="OnStartTimer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TimerList" ItemTemplate="{StaticResource TimerCard}"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- STOPWATCH -->
            <TabItem Header="{x:Static l:Text.TabStopwatch}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static l:Text.StopwatchTitle}" Style="{StaticResource TabTitle}"/>
                    <TextBlock Grid.Row="1" x:Name="StopwatchText" Text="00:00:00.00" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="StopwatchStartPauseBtn" Content="{x:Static l:Text.Start}" Click="OnStopwatchStartPause" FontSize="16" Padding="20,10"/>
                        <Button Content="{x:Static l:Text.Lap}" Click="OnStopwatchLap" FontSize="16" Padding="20,10"/>
                        <Button Content="{x:Static l:Text.Reset}" Click="OnStopwatchReset" FontSize="16" Padding="20,10"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <ItemsControl x:Name="LapList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LapLabel}" FontSize="16"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LapTime}" FontSize="16"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- WORLD CLOCK -->
            <TabItem Header="{x:Static l:Text.TabWorldClock}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="{x:Static l:Text.WorldClockTitle}" Style="{StaticResource TabTitle}"/>
                        <Button Content="{x:Static l:Text.AddCity}" Click="OnAddCity" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CityList" ItemTemplate="{StaticResource CityCard}"/>
                        </ScrollViewer>
                        <DockPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBox x:Name="CitySearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" ToolTip="{x:Static l:Text.SearchCity}" TextChanged="CitySearchBox_TextChanged"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="CityCatalogList" SelectionMode="Multiple" SelectionChanged="CityCatalogList_SelectionChanged"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- SETTINGS -->
            <TabItem Header="{x:Static l:Text.TabSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Static l:Text.SettingsTitle}" Style="{StaticResource TabTitle}"/>
                        <CheckBox x:Name="Is24HourBox" Content="{x:Static l:Text.Use24Hour}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{x:Static l:Text.WeekStartsOn}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="WeekStartBox" SelectionChanged="OnSettingChanged" Width="120" DisplayMemberPath="Display"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{x:Static l:Text.Theme}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ThemeBox" SelectionChanged="OnSettingChanged" Width="120">
                                <ComboBoxItem Content="{x:Static l:Text.ThemeSystem}"/>
                                <ComboBoxItem Content="{x:Static l:Text.ThemeLight}"/>
                                <ComboBoxItem Content="{x:Static l:Text.ThemeDark}"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{x:Static l:Text.AlarmSnoozeMin}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="AlarmSnoozeBox" Width="60" LostFocus="OnSettingChanged" TextChanged="OnSettingChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{x:Static l:Text.AlarmAutoSilenceSec}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="AlarmAutoSilenceBox" Width="60" LostFocus="OnSettingChanged" TextChanged="OnSettingChanged"/>
                        </StackPanel>
                        <Separator Margin="0,16"/>
                        <TextBlock Text="{x:Static l:Text.TimerDefaults}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                        <CheckBox x:Name="TimerVibrateBox" Content="{x:Static l:Text.VibrateWhenTimerExpires}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <CheckBox x:Name="TimerFlashBox" Content="{x:Static l:Text.FlashOnExpiry}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <CheckBox x:Name="TimerAutoSilenceBox" Content="{x:Static l:Text.AutoSilenceAfter10Min}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <Separator Margin="0,16"/>
                        <TextBlock Text="{x:Static l:Text.Data}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                        <Button Content="{x:Static l:Text.SaveNow}" Click="OnSaveNow"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SYNC -->
            <TabItem Header="{x:Static l:Text.TabSync}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static l:Text.LanSyncTitle}" Style="{StaticResource TabTitle}"/>
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <CheckBox x:Name="SyncEnabledBox" Content="{x:Static l:Text.EnableLanSync}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{x:Static l:Text.DeviceName}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SyncNameBox" Width="180" LostFocus="OnSettingChanged" TextChanged="OnSettingChanged"/>
                            <TextBlock Text="{x:Static l:Text.Port}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <TextBox x:Name="SyncPortBox" Width="60" LostFocus="OnSettingChanged" TextChanged="OnSettingChanged"/>
                            <Button Content="{x:Static l:Text.SyncNow}" Click="OnSyncNow" Margin="16,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="SyncStatusText" Foreground="#666666" Margin="0,4,0,8" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="3" Text="{x:Static l:Text.DiscoveredDevices}" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PeerList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,6" Background="#0D000000">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#77000000"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
