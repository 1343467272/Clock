<Window x:Class="Clock.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Clock.Windows.Localization"
        Title="{x:Static l:Text.AppTitle}" Height="720" Width="900"
        WindowStartupLocation="CenterScreen" Icon="Assets/icon.ico"
        Background="{DynamicResource BkBackground}" Foreground="{DynamicResource BkOnSurface}">

    <Window.Resources>
        <!-- Material palette brushes come from the active theme dictionary (ThemeManager). -->

