<Window x:Class="Clock.Windows.Controls.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Clock.Windows.Localization"
        Title="{x:Static l:Text.AppTitle}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="MessageText" FontSize="32" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,24"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SnoozeButton" Content="{x:Static l:Text.Snooze}" Click="OnSnooze" Visibility="Collapsed"/>
            <Button x:Name="DismissButton" Content="{x:Static l:Text.Dismiss}" IsDefault="True" Click="OnDismiss"/>
        </StackPanel>
    </StackPanel>
</Window>
