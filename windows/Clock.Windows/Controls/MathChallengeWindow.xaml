<Window x:Class="Clock.Windows.Controls.MathChallengeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Clock.Windows.Localization"
        Title="{x:Static l:Text.MathChallengeCategoryTitle}" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BkBackground}" Foreground="{DynamicResource BkOnSurface}">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="PromptText" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBox x:Name="AnswerBox" FontSize="18" Padding="6" ToolTip="{x:Static l:Text.MathChallengeAnswerHint}" TextChanged="OnAnswerChanged"/>
        <TextBlock x:Name="ErrorText" Foreground="#D32F2F" Margin="0,8,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static l:Text.MathChallengeNewProblem}" Click="OnNewProblem" Margin="0,0,8,0"/>
            <Button Content="{x:Static l:Text.Cancel}" Click="OnCancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="{x:Static l:Text.Confirm}" Click="OnConfirm" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
