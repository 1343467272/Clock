<Window x:Class="Clock.Windows.Controls.AlarmEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Clock.Windows.Localization"
        Title="{x:Static l:Text.AlarmWindowTitle}" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BkBackground}" Foreground="{DynamicResource BkOnSurface}">
    <StackPanel Margin="20">
        <TextBlock Text="{x:Static l:Text.Time}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="HourBox" Width="70"/>
            <TextBlock Text=":" FontSize="22" VerticalAlignment="Center" Margin="6,0"/>
            <ComboBox x:Name="MinuteBox" Width="70"/>
        </StackPanel>

        <TextBlock Text="{x:Static l:Text.Repeat}" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <ItemsControl x:Name="DayToggleList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,2"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{x:Static l:Text.Options}" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <CheckBox x:Name="VibrateBox" Content="{x:Static l:Text.Vibrate}" Margin="0,2"/>
        <CheckBox x:Name="FlashBox" Content="{x:Static l:Text.Flash}" Margin="0,2"/>
        <CheckBox x:Name="DeleteAfterUseBox" Content="{x:Static l:Text.DeleteAfterUse}" Margin="0,2"/>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{x:Static l:Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="LabelBox" Width="240"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{x:Static l:Text.SnoozeMinutes}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="SnoozeBox" Width="70"/>
            <TextBlock Text="{x:Static l:Text.AutoSilenceSeconds}" VerticalAlignment="Center" Margin="12,0,8,0"/>
            <ComboBox x:Name="AutoSilenceBox" Width="90"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{x:Static l:Text.Cancel}" Click="OnCancel" IsCancel="True"/>
            <Button Content="{x:Static l:Text.Save}" Click="OnSave" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
