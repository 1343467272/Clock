<Window x:Class="Clock.Windows.Controls.AlarmEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Time" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="HourBox" Width="70"/>
            <TextBlock Text=":" FontSize="22" VerticalAlignment="Center" Margin="6,0"/>
            <ComboBox x:Name="MinuteBox" Width="70"/>
        </StackPanel>

        <TextBlock Text="Repeat" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <ItemsControl x:Name="DayToggleList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,2"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Options" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <CheckBox x:Name="VibrateBox" Content="Vibrate" Margin="0,2"/>
        <CheckBox x:Name="FlashBox" Content="Flash" Margin="0,2"/>
        <CheckBox x:Name="DeleteAfterUseBox" Content="Delete after use (one-time only)" Margin="0,2"/>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Label" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="LabelBox" Width="240"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Snooze (min)" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="SnoozeBox" Width="70"/>
            <TextBlock Text="Auto-silence (sec)" VerticalAlignment="Center" Margin="12,0,8,0"/>
            <ComboBox x:Name="AutoSilenceBox" Width="90"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Click="OnCancel" IsCancel="True"/>
            <Button Content="Save" Click="OnSave" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
